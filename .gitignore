# Banco de dados da aplicação (JSON flat-file)
# Contém orçamentos, clientes, produtos, configurações,
# dados financeiros e demais informações operacionais.
/data/

# Claude Code — memórias, planos, transcrições de sessão
# Contém contexto de desenvolvimento, instruções personalizadas
# e registros de conversas anteriores.
/.claude/
